# .env.example — İSTEMCİ tarafı değişkenler. Şablon; gerçek değer içermez.
#
#   cp .env.example .env.local     ve değerleri doldur
#
# ⚠️ DİKKAT — GİZLİLİK
# `VITE_` önekli her değişken build sırasında İSTEMCİ PAKETİNE GÖMÜLÜR ve
# tarayıcıdan okunabilir. Buraya asla parola, secret, oturum anahtarı yazma.
# Gizli değerler `.dev.vars` (geliştirme) ve `wrangler secret put` (production)
# üzerinden Worker'a gider — bkz. .dev.vars.example
#
# Bu değişkenler BUILD ANINDA okunur. `npm run deploy` çalıştırdığında
# .env.local dosyan yerinde olmalı, yoksa harita anahtarsız derlenir.


# MapTiler stil URL'i (anahtar dahil). ADR-002.
# maptiler.com/cloud → ücretsiz hesap → API key. Kart bilgisi istemiyor.
# Ücretsiz plan: 100.000 harita yüklemesi/ay; kota dolunca harita durur,
# sürpriz fatura çıkmaz.
#
# Anahtarı MUTLAKA MapTiler panelinden origin kısıtına bağla:
#   Account → API keys → anahtarı seç → Allowed origins
#   https://nobetci-eczane.becayisler.com/*  ve  http://localhost:5173/*
#
# Koyu tema tasarımla uyumlu stiller: streets-v2-dark, dataviz-dark, backdrop-dark
VITE_MAP_STYLE_URL="https://api.maptiler.com/maps/streets-v2-dark/style.json?key=ANAHTARINI_YAZ"

# Konum izni yokken haritanın açılacağı merkez. Varsayılan: Antalya merkez.
VITE_MAP_DEFAULT_LAT="36.8969"
VITE_MAP_DEFAULT_LNG="30.7133"
VITE_MAP_DEFAULT_ZOOM="12"
