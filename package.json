{
  "name": "nobetci-eczane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Türkiye için nöbetçi eczane bulma uygulaması — web + PWA",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "tsx src/node/server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "gen:types": "openapi-typescript contracts/openapi.yaml -o src/shared/api-types.d.ts",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply nobetci-eczane --local",
    "db:seed": "wrangler d1 execute nobetci-eczane --local --file seed/dummy-data.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate && npm run db:seed",
    "typecheck": "tsc -b",
    "lint:es": "eslint .",
    "lint:format": "prettier --check .",
    "lint": "npm run typecheck && npm run lint:es && npm run lint:format",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run build && wrangler deploy --dry-run",
    "hash-password": "node scripts/hash-password.mjs",
    "deploy": "vite build && wrangler deploy",
    "scrape": "node scripts/scrape-edevlet.mjs",
    "scrape:eczaneler": "node scripts/scrape-eczaneler.mjs",
    "scrape:v2": "node scripts/scrape-eczaneler-v2.mjs",
    "scrape:edevlet": "node scripts/scrape-edevlet.mjs",
    "mcp": "tsx src/mcp/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.13.1",
    "maplibre-gl": "^5.24.0",
    "playwright-core": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tsx": "^4.23.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260808.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
